<?xml version="1.0" encoding="utf-8"?>
<!--
  The illustration fills its own square, so it is inset to sit inside the adaptive icon's safe
  zone. Its background is the same navy as the background layer, which is why the seam is
  invisible whatever shape the launcher masks it to.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/ic_launcher_illustration"
    android:inset="18%" />
